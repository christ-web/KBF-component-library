{
  "version": 2,
  "category": "Media",
  "icon": "video",
  "completion": "explicit",
  "styleTokens": [
    "--kbf-border-radius",
    "--kbf-color-bg",
    "--kbf-color-border",
    "--kbf-color-heading",
    "--kbf-color-muted",
    "--kbf-color-primary",
    "--kbf-color-surface",
    "--kbf-color-text",
    "--kbf-font-body",
    "--kbf-font-heading",
    "--kbf-color-hover-bg",
    "--kbf-color-hover-text"
  ],
  "groups": [
    {
      "key": "content",
      "label": "Content",
      "owner": "id",
      "order": 0
    }
  ],
  "fields": {
    "title": {
      "label": "Video title (optional)",
      "group": "content",
      "type": "text",
      "order": 0
    },
    "src": {
      "label": "Video file (.mp4)",
      "group": "content",
      "accept": "video",
      "type": "url",
      "order": 1
    },
    "vtt": {
      "label": "Captions VTT",
      "group": "content",
      "accept": "caption",
      "warnWhenEmpty": "No captions: this video will ship without them, which fails WCAG 1.2.2 (Level A). Add a VTT file.",
      "type": "url",
      "order": 2
    },
    "poster": {
      "optional": true,
      "label": "Poster image (optional)",
      "group": "content",
      "accept": "image",
      "size": {
        "width": 1920,
        "height": 1080,
        "note": "Fitted into a 16:9 frame."
      },
      "type": "url",
      "order": 3
    },
    "show_captions": {
      "label": "Show captions by default",
      "group": "content",
      "default": false,
      "type": "boolean",
      "order": 4
    },
    "show_transcript": {
      "label": "Show transcript toggle",
      "group": "content",
      "default": true,
      "type": "boolean",
      "order": 5
    },
    "blocking": {
      "label": "Learner must finish this to go on",
      "group": "content",
      "default": true,
      "whenLocked": true,
      "help": "Holds the page until 95% of the video is watched. Off, this video does not hold it.",
      "type": "boolean",
      "order": 6
    }
  }
}
