{
  "version": 2,
  "category": "Interactives",
  "icon": "eye",
  "completion": "explicit",
  "styleTokens": [
    "--kbf-color-surface",
    "--kbf-color-text",
    "--kbf-color-heading",
    "--kbf-color-border",
    "--kbf-radius-lg",
    "--kbf-type-heading-m",
    "--kbf-type-body"
  ],
  "groups": [
    {
      "key": "content",
      "label": "Content",
      "owner": "id",
      "order": 0
    },
    {
      "key": "setup",
      "label": "Setup",
      "owner": "dev",
      "order": 1
    }
  ],
  "fields": {
    "heading": {
      "label": "Heading",
      "group": "content",
      "required": true,
      "maxLength": 120,
      "type": "text",
      "order": 0
    },
    "intro": {
      "label": "Intro text",
      "group": "content",
      "rows": 3,
      "type": "textarea",
      "order": 1
    },
    "button_label": {
      "label": "Button label",
      "group": "content",
      "default": "Show more",
      "maxLength": 40,
      "type": "text",
      "order": 2
    },
    "reveal_text": {
      "label": "Revealed text",
      "group": "content",
      "required": true,
      "rows": 4,
      "type": "textarea",
      "order": 3
    },
    "image": {
      "label": "Picture",
      "group": "content",
      "accept": "image",
      "optional": true,
      "altField": "image_alt",
      "size": {
        "width": 800,
        "height": 600,
        "crop": true,
        "note": "Drawn in a 4:3 frame beside the text."
      },
      "type": "url",
      "order": 4
    },
    "image_alt": {
      "label": "Picture description (alt text)",
      "group": "content",
      "type": "text",
      "order": 5
    },
    "image_side": {
      "label": "Picture side",
      "group": "setup",
      "ga": true,
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "type": "select",
      "order": 6
    },
    "allow_hide": {
      "label": "Learner can hide the text again",
      "group": "setup",
      "default": true,
      "help": "Off: once shown, the text stays shown.",
      "type": "boolean",
      "order": 7
    }
  }
}
